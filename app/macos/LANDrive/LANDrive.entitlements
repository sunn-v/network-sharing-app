<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- File Provider extensions must be sandboxed. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Shared with the app: bridge.json lives in this group's container. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>$(TeamIdentifierPrefix)cafe.getapps.networksharing</string>
  </array>
  <!-- Talks to the app's bridge on 127.0.0.1. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
